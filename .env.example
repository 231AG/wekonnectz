# Copy to .env.local and fill in. Never commit .env.local. Never use NEXT_PUBLIC_ for secrets.

# Supabase (local values come from `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (T-17). Leave empty to keep Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Scheduled jobs (Vercel Cron sends it as a bearer token). Long random value; set in Vercel, never commit.
CRON_SECRET=

# Card payments (Phase 7b scaffold). Keep CARD_PAYMENTS_ENABLED=0 in production until a processor is chosen (OD-4).
# CARD_PROCESSOR=fake and FAKE_CARD_WEBHOOK_SECRET are for local development and tests only.
CARD_PAYMENTS_ENABLED=0
CARD_PROCESSOR=
FAKE_CARD_WEBHOOK_SECRET=

# Development only: enables /ui-kit and /ui-kit/admin
ENABLE_UI_KIT=
