# Copy to .env.local and fill in. Never commit .env.local. Never use NEXT_PUBLIC_ for secrets.

# Supabase (local values come from `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (T-17). Leave empty to keep Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Development only: enables /ui-kit and /ui-kit/admin
ENABLE_UI_KIT=
